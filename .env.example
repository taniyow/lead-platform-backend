# Runtime
NODE_ENV=development
# Bind host. Keep 127.0.0.1 so the backend is never publicly exposed;
# the Next.js frontend reaches it over the internal interface.
HOST=127.0.0.1
PORT=4001

# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/lead_platform"

# Auth
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Admin seed account (used by the seed script only; never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
